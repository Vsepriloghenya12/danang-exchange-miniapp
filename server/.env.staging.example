# Шаблон переменных сервиса Railway в окружении staging.
# Заполнить значения в Railway Variables до запуска сервиса.
NODE_ENV=production
ROLE=monolith
PORT=8080

# Токен НОВОГО тестового бота и Telegram ID владельца.
BOT_TOKEN=
OWNER_TG_IDS=

# Один и тот же HTTPS-адрес тестового сервиса, без завершающего /.
WEBAPP_URL=
PUBLIC_URL=

# Отдельный секрет входа в /admin тестового сервиса.
ADMIN_WEB_KEY=

# Подключение к отдельному PostgreSQL в staging.
DATABASE_URL=

# Только тестовые группы: публикация курсов и приём заявок.
GROUP_CHAT_ID=
REQUESTS_GROUP_CHAT_ID=

# Имя тестового бота без @. TMA_LINK можно оставить пустым.
BOT_USERNAME=
TMA_LINK=

# Отдельный volume, смонтированный в /data.
STORE_PATH=/data/store.json
REQUEST_ATTACHMENT_STORAGE_DIR=/data/request-attachments

# Необязательно: погода в приложении.
OWM_API_KEY=
